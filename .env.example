NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
AI_PROVIDER=fake
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# Select gemini for hosted embeddings, ollama for local development, or fake for tests only.
EMBEDDING_PROVIDER=fake
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Shared Gemini workload ceilings; usage is reserved before each provider request.
GEMINI_INTERACTIVE_USER_DAILY_USAGE_UNITS=120
GEMINI_BACKGROUND_USER_DAILY_USAGE_UNITS=600
GEMINI_INTERACTIVE_APP_DAILY_USAGE_UNITS=5000
GEMINI_BACKGROUND_APP_DAILY_USAGE_UNITS=20000
GEMINI_TOTAL_APP_DAILY_USAGE_UNITS=25000
GEMINI_MAX_IN_FLIGHT_REQUESTS=4
# Course material admission limits; notes count by UTF-8 byte size.
COURSE_MATERIAL_DAILY_COUNT_LIMIT=5
COURSE_MATERIAL_DAILY_BYTES_LIMIT=52428800
COURSE_MATERIAL_MANUAL_RETRY_LIMIT=2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
REMOTEOK_METADATA_PILOT=false
HIMALAYAS_METADATA_ENABLED=false
